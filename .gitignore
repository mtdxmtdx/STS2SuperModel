# ---------------------------------------------------------------------------
# 构建与缓存产物
# ---------------------------------------------------------------------------
**/bin/
**/obj/
**/.pytest_cache/
**/__pycache__/
**/test-output/
**/pytest-cache-files-*/
.python-deps/

# ---------------------------------------------------------------------------
# 本机游戏运行时二进制（从本地安装获取，不入库）
# ---------------------------------------------------------------------------
sts2-cli-v0111/lib/*.dll
sts2-cli-v0111/lib/*.pdb
sts2-cli-v0111/lib/*.exe
sts2-cli-v0111/lib/decompiled/
sts2.dll
sts2.pdb

# ---------------------------------------------------------------------------
# 本机运行时数据
# ---------------------------------------------------------------------------
sts2-cli-v0111/logs/
sts2-cli-v0111/saves/

# 本地临时工作区（脚本中间产物，可随时重建）
work/

# 标注 GUI 的运行时数据库（本机标注状态，非源码）
sts2-seed-gui/data/*.sqlite
sts2-seed-gui/data/*.sqlite-journal
sts2-seed-gui/data/*.db

# 误建文件：曾因 shell 重定向手误产生
ignored

# ---------------------------------------------------------------------------
# 大型派生数据集
# ---------------------------------------------------------------------------
# 策略：
#   入库   —— manifest / 质量门禁 / 差分报告 / 覆盖率报告（*.json、*.md）。
#             这些是审计追溯链，体积小、不可重建。
#   不入库 —— 数据集本体（*.jsonl / *.parquet / *.pt）与原始 CLI 转储（*.txt）。
#             体积大、可由 manifest 记录的参数 + SHA-256 重新生成或重新采集。
#
# 例外：
#   1. 历史上已被跟踪的数据文件不受这些规则影响，仍然保留在版本库中
#      （gitignore 不作用于已跟踪文件），因此远端既有数据的历史连续性不变。
#   2. 确实需要长期版本化的精选数据集，用 `git add -f <path>` 显式加入，
#      并在提交信息中说明入库理由。
data/**/*.jsonl
data/**/*.parquet
data/**/*.pt
data/**/*.onnx
data/*.txt

# ---------------------------------------------------------------------------
# 模型交付物例外 —— 必须版本化
# ---------------------------------------------------------------------------
# 上面的 *.pt / *.onnx 规则针对「可重建的派生数据」。但模型产物是**交付物**,
# 不属于那一类,理由有三:
#   1. 体积小:单个 < 1 MB,combat_model 全部合计约 3 MB
#   2. **无法**从库内内容重建:训练数据在 work/(整目录已忽略),
#      所以即使训练是确定性的(已验证 23 张量逐位一致),库内也没有输入可复现
#   3. manifest / vocabulary / parity 记录是可追溯性的**全部依据** ——
#      没有它们就无法回答「这个模型是怎么来的、验证过什么」
#
# 仍然排除放在这些目录下的数据集本体(*.jsonl / *.parquet 不在下列例外中)。
!data/combat_model/**/*.json
!data/combat_model/**/*.onnx
!data/combat_model/**/*.pt
!data/global_prototype/**/*.pt

# 临时与重复产物（P3-4：命名改内容寻址后应彻底消失）
data/**/*.tmp.json
data/**/tmp-*.json
data/**/*.repeat.jsonl
data/**/*-repeat.jsonl
