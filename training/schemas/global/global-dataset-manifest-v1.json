{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalDatasetManifestV1",
  "type": "object",
  "required": ["dataset_id", "schema_version", "stage", "game_version", "game_branch", "game_commit", "assembly_sha256", "cli_protocol_version", "simulator_version", "semantic_catalog_version", "feature_schema_version", "model_version", "generator_config_hash", "feature_config_hash", "split_policy", "row_count", "state_count", "action_count", "reliable_count", "estimated_count", "uncalculable_count", "source_hashes", "created_at_utc"],
  "properties": {
    "dataset_id": {"type": "string"},
    "schema_version": {"type": "string"},
    "stage": {"type": "string"},
    "game_version": {"type": "string"},
    "game_branch": {"type": "string"},
    "game_commit": {"type": "string"},
    "assembly_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "cli_protocol_version": {"type": "string"},
    "simulator_version": {"type": "string"},
    "semantic_catalog_version": {"type": "string"},
    "feature_schema_version": {"type": "string"},
    "model_version": {"type": "string"},
    "generator_config_hash": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "feature_config_hash": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "split_policy": {"type": "string"},
    "row_count": {"type": "integer", "minimum": 0},
    "state_count": {"type": "integer", "minimum": 0},
    "action_count": {"type": "integer", "minimum": 0},
    "reliable_count": {"type": "integer", "minimum": 0},
    "estimated_count": {"type": "integer", "minimum": 0},
    "uncalculable_count": {"type": "integer", "minimum": 0},
    "source_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}},
    "created_at_utc": {"type": "string"},
    "label_source": {"type": "string"},
    "public_leakage_count": {"type": "integer", "minimum": 0},
    "stable_id_missing": {"type": "integer", "minimum": 0},
    "quality_counts": {"type": "object"}
  },
  "additionalProperties": true
}
