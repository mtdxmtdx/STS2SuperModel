{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DatasetManifestV1",
  "type": "object",
  "required": [
    "dataset_id",
    "schema_version",
    "game_version",
    "game_commit",
    "assembly_sha256",
    "cli_protocol_version",
    "simulator_version",
    "scorer_version",
    "semantic_database_version",
    "feature_schema_version",
    "model_version",
    "generator_config_hash",
    "feature_config_hash",
    "split_policy",
    "row_count",
    "state_count",
    "action_count",
    "reliable_count",
    "estimated_count",
    "uncalculable_count",
    "source_hashes",
    "created_at_utc"
  ],
  "properties": {
    "dataset_id": { "type": "string" },
    "schema_version": { "type": "integer", "const": 1 },
    "game_version": { "type": "string", "const": "v0.111.0" },
    "game_commit": { "type": "string", "const": "41cef1ea" },
    "assembly_sha256": { "type": "string", "const": "0861BFA1DF347538D932F22D580E75420F08082792EB914E53B4882764ACDBE9" },
    "cli_protocol_version": { "type": "string", "const": "0.2.0" },
    "simulator_version": { "type": "string" },
    "scorer_version": { "type": "string" },
    "semantic_database_version": { "type": "string" },
    "feature_schema_version": { "type": "string" },
    "model_version": { "type": "string" },
    "generator_config_hash": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "feature_config_hash": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "split_policy": { "type": "string" },
    "row_count": { "type": "integer", "minimum": 0 },
    "state_count": { "type": "integer", "minimum": 0 },
    "action_count": { "type": "integer", "minimum": 0 },
    "reliable_count": { "type": "integer", "minimum": 0 },
    "estimated_count": { "type": "integer", "minimum": 0 },
    "uncalculable_count": { "type": "integer", "minimum": 0 },
    "confidence_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "source_hashes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
    },
    "created_at_utc": { "type": "string" }
  },
  "additionalProperties": true
}
