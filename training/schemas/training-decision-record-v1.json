{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrainingDecisionRecordV1",
  "type": "object",
  "required": [
    "record_id",
    "schema_version",
    "trace_schema",
    "game_version",
    "game_commit",
    "assembly_sha256",
    "cli_protocol_version",
    "simulator_version",
    "scorer_version",
    "semantic_database_version",
    "feature_schema_version",
    "model_version",
    "generator_config_hash",
    "episode_id",
    "character",
    "ascension",
    "act",
    "floor",
    "combat_id",
    "round",
    "state_hash_public",
    "state_hash_teacher",
    "public_state",
    "legal_actions",
    "teacher_best_actions",
    "action_values",
    "confidence",
    "search_complete"
  ],
  "properties": {
    "record_id": { "type": "string" },
    "schema_version": { "type": "integer", "const": 1 },
    "trace_schema": { "type": "integer", "const": 1 },
    "game_version": { "type": "string", "const": "v0.111.0" },
    "game_commit": { "type": "string", "const": "41cef1ea" },
    "assembly_sha256": { "type": "string", "const": "0861BFA1DF347538D932F22D580E75420F08082792EB914E53B4882764ACDBE9" },
    "cli_protocol_version": { "type": "string", "const": "0.2.0" },
    "simulator_version": { "type": "string" },
    "scorer_version": { "type": "string" },
    "semantic_database_version": { "type": "string" },
    "feature_schema_version": { "type": "string" },
    "model_version": { "type": "string" },
    "generator_config_hash": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "episode_id": { "type": "string" },
    "character": { "type": "string" },
    "ascension": { "type": "integer", "minimum": 0 },
    "act": { "type": "integer", "minimum": 0 },
    "floor": { "type": "integer", "minimum": 0 },
    "combat_id": { "type": "string" },
    "round": { "type": "integer", "minimum": 0 },
    "state_hash_public": { "type": "string" },
    "state_hash_teacher": { "type": "string" },
    "public_state": { "$ref": "public-state-schema-v1.json" },
    "nosl_belief_state": { "$ref": "nosl-belief-state-v1.json" },
    "teacher_state_reference": { "type": ["string", "null"] },
    "legal_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "action_id", "effective_energy_cost", "legal"],
        "properties": {
          "kind": { "type": "string", "enum": ["PlayCard", "UsePotion", "Choice", "EndTurn"] },
          "action_id": { "type": "string" },
          "source_model_id": { "type": ["string", "null"] },
          "source_instance_id": { "type": ["string", "null"] },
          "target_id": { "type": ["string", "null"] },
          "choice_id": { "type": ["string", "null"] },
          "selected_card_instance_ids": { "type": "array", "items": { "type": "string" } },
          "effective_energy_cost": { "type": "integer" },
          "legal": { "type": "boolean" },
          "restriction": { "type": ["string", "null"] }
        }
      }
    },
    "legal_actions_complete": { "type": "boolean" },
    "teacher_best_actions": { "type": "array", "items": { "type": "string" } },
    "action_values": { "type": "object", "additionalProperties": { "type": "number" } },
    "confidence": { "type": "string", "enum": ["Reliable", "Estimated", "LowConfidence", "Uncalculable"] },
    "search_complete": { "type": "boolean" },
    "risk_events": { "type": "array", "items": { "type": "string" } },
    "risk_summary": { "type": ["string", "null"] },
    "provenance": { "type": "object" }
  },
  "additionalProperties": true
}
